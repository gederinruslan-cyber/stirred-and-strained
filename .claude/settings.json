{
  "permissions": {
    "allow": [
      "Bash(pnpm *)",
      "Bash(pnpm exec playwright *)",
      "Bash(docker compose *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(node scripts/*)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge --squash *)",
      "Bash(git merge --ff-only *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only *)",
      "Bash(git push origin change/*)",
      "Bash(git push -u origin change/*)",
      "Bash(git push origin --delete change/*)",
      "Bash(git push origin main)",
      "Bash(git push origin --tags)",
      "Bash(git tag *)",
      "Bash(git stash *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree *)",
      "Bash(gh run *)",
      "Bash(gh repo view *)",
      "Bash(curl http://localhost*)",
      "Bash(curl -s http://localhost*)",
      "Edit(apps/**)",
      "Edit(packages/**)",
      "Edit(e2e/**)",
      "Edit(specs/**)",
      "Edit(docs/**)",
      "Edit(scripts/**)",
      "Edit(data/**)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin +*)",
      "Bash(git reset --hard *)",
      "Bash(git clean -fdx *)",
      "Bash(git filter-branch *)",
      "Bash(git push origin --delete main)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Bash(gh secret *)",
      "Bash(gh auth *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(node -e *)",
      "Bash(node --eval *)",
      "Bash(node -p *)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(fly deploy *)",
      "Bash(flyctl deploy *)",
      "Bash(railway up *)",
      "Bash(render deploy *)",
      "Bash(vercel *)",
      "Bash(docker system prune *)",
      "Bash(docker volume rm *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/stop-check.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
