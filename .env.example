# Local-only defaults; copy to .env to override. Never put real credentials here.
POSTGRES_USER=stirred
POSTGRES_PASSWORD=stirred_local_only
POSTGRES_DB=stirred
POSTGRES_PORT=5433
API_PORT=4300
WEB_PORT=3300
MIGRATOR_DB_PASSWORD=stirred_migrator_local_only
APP_DB_PASSWORD=stirred_app_local_only
# One URL per role (ADR 0003). `pnpm db:setup` needs the first two; the api uses DATABASE_URL.
DATABASE_ADMIN_URL=postgres://stirred:stirred_local_only@127.0.0.1:5433/stirred
MIGRATION_DATABASE_URL=postgres://stirred_migrator:stirred_migrator_local_only@127.0.0.1:5433/stirred
DATABASE_URL=postgres://stirred_app:stirred_app_local_only@127.0.0.1:5433/stirred
# For the web server (server-side calls to the api):
API_URL=http://127.0.0.1:4300
